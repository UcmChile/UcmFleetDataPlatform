PORT=4010
CORS_ALLOW_LOCALHOST=true
CORS_ORIGIN=http://localhost:5180

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ucm_fleet
DB_USER=app_user
DB_PASSWORD=123456
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=ucm-fleet-dev-secret-change-me
# Debe coincidir con JWT_SECRET del portal UCM SSO para aceptar #sso_token.
SSO_JWT_SECRET=change-me-to-match-ucm-sso
JWT_EXPIRES_IN_SECONDS=28800

# Traumasoft (sync organización vehículos: npm run traumasoft:sync-org)
# TS_HOST=remotereporting.traumasoft.com
# TS_PORT=6033
# TS_USER=ucm_ro
# TS_DB=traumasoft_ucm
# TS_PASSWORD=

# Wisetrack API Gateway
WISETRACK_BASE_URL=https://api-gateway.wisetrack.cl/prod
WISETRACK_AUTH_PATH=/ucm/v1/auth/getToken
WISETRACK_ENABLED=true
# Credenciales se administran en UI (tabla wisetrack_api_config), no en .env
